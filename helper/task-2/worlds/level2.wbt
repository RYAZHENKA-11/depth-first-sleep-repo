#VRML_SIM R2025a utf8
# Go2 competition — Level 2 "Slalom & Maze" (medium).
# Course: start → 3-pole slalom → cp1 → FULL-SIZE MAZE (16×12, cell 1.5 m, with dead ends) →
# more checkpoints scattered through the maze → exit → finish.
# Same fixed robot/referee as Level 1; only the obstacles + config change.

EXTERNPROTO "../common/protos/Go2.proto"
EXTERNPROTO "../common/protos/Checkpoint.proto"
EXTERNPROTO "../common/protos/Wall.proto"
EXTERNPROTO "../common/protos/Pole.proto"
EXTERNPROTO "../common/protos/Ball.proto"
EXTERNPROTO "../common/protos/ArmStation.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/toys/protos/RubberDuck.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/factory/containers/protos/PlasticCrate.proto"

# Physics = EXACTLY our verified reference physics (the firmware MNN policy walks
# stably on it): timestep 4 ms, friction 1.3, no damping/CFM overrides. Do not tweak.
WorldInfo {
  basicTimeStep 4
  contactProperties [
    ContactProperties {
      material1 "default"
      material2 "ground"
      coulombFriction [ 1.3 ]
      bounce 0
    }
  ]
}
Viewpoint {
  orientation -0.32 0.31 0.9 1.66
  position 0.2 -3.8 3.0
  follow "Go2"
  followType "Tracking Shot"
  followSmoothness 0.35
}
TexturedBackground { texture "factory" }
TexturedBackgroundLight { texture "factory" luminosity 1.6 }
DirectionalLight { direction 0.6 -1 -0.9 intensity 2.2 castShadows TRUE }

DEF FLOOR Solid {
  translation 16.45 0.9 -0.5
  children [
    Shape {
      appearance PBRAppearance {
        baseColorMap ImageTexture { url [ "../common/protos/textures/Checker.png" ] }
        textureTransform TextureTransform { scale 21 14 }
        roughness 0.6
        metalness 0.0
      }
      geometry Box { size 41.5 27.6 1 }
    }
  ]
  boundingObject Box { size 41.5 27.6 1 }
  contactMaterial "ground"
}

# ── participant robot (controller swapped at judging) ──
DEF ROBOT Go2 {
  translation 0 0 0.34
  rotation 0 0 1 0
  name "Go2"
  controller "participant"
  supervisor FALSE
}

# ── referee (separate supervisor) ──
DEF REF Robot {
  name "referee"
  controller "referee"
  controllerArgs [ "../../config/level2.json" ]
  supervisor TRUE
}

# ── slalom: three poles ALTERNATING sides → the robot weaves through with wide clearance ──
Pole { translation 1.7 -0.45 0.4 name "slalom1" radius 0.15 height 0.8 }
Pole { translation 3.1  0.45 0.4 name "slalom2" radius 0.15 height 0.8 }
Pole { translation 4.5 -0.45 0.4 name "slalom3" radius 0.15 height 0.8 }

# ══════════ SORTING STATION (task solved IN PARALLEL, remotely via robot.arm) ══════════
# Stationary manipulator; tray S of it holds balls (S→N: red, green, blue), the slot stand
# N of it has colour pads (S→N: blue, red, green). All three balls on matching pads → the
# SECRET DOOR deep in the maze opens (a shortcut). Arm frame origin = pedestal centre.
DEF ARM ArmStation { translation 2.2 2.0 0 name "arm_station" controllerArgs [ "BALL_R" "BALL_G" "BALL_B" ] }
# RAISED tray (top z0.20) — balls sit at z0.26, at radius 0.28–0.52 from the arm (its comfortable
# reach; balls near the pedestal would be inside the arm's fold limit and unreachable).
DEF TRAY Solid {
  translation 2.2 1.60 0
  children [
    Pose { translation 0 0 0.10 children [ Shape { appearance DEF TRAYAPP PBRAppearance { baseColor 0.35 0.30 0.22 roughness 0.8 } geometry Box { size 0.30 0.50 0.20 } } ] }
    # shallow cups so the resting balls don't roll off the raised platform
    Pose { translation 0 -0.12 0.21 children [ Shape { appearance USE TRAYAPP geometry Cylinder { radius 0.075 height 0.02 } } ] }
    Pose { translation 0  0.00 0.21 children [ Shape { appearance USE TRAYAPP geometry Cylinder { radius 0.075 height 0.02 } } ] }
    Pose { translation 0  0.12 0.21 children [ Shape { appearance USE TRAYAPP geometry Cylinder { radius 0.075 height 0.02 } } ] }
  ]
  name "tray"
  boundingObject Pose { translation 0 0 0.10 children [ Box { size 0.30 0.50 0.20 } ] }
}
DEF BALL_R Ball { translation 2.2 1.48 0.26 color 0.90 0.10 0.10 name "ball_red" }
DEF BALL_G Ball { translation 2.2 1.60 0.26 color 0.10 0.80 0.15 name "ball_green" }
DEF BALL_B Ball { translation 2.2 1.72 0.26 color 0.12 0.30 0.95 name "ball_blue" }
DEF SLOTS Solid {
  translation 2.2 2.3 0
  rotation 0 0 1 1.5708
  children [
    # solid platform (the ONLY collision) — the arm places a ball above a pad and it rests here
    Pose { translation 0 0 0.11 children [ Shape { appearance DEF SLOTAPP PBRAppearance { baseColor 0.22 0.22 0.26 roughness 0.5 metalness 0.3 } geometry Box { size 0.26 0.54 0.22 } } ] }
    # LOW cosmetic dividers (visual only — no collision — so the arm freely brings a ball over)
    Pose { translation  0.125 0 0.245 children [ Shape { appearance USE SLOTAPP geometry Box { size 0.014 0.52 0.05 } } ] }
    Pose { translation -0.125 0 0.245 children [ Shape { appearance USE SLOTAPP geometry Box { size 0.014 0.52 0.05 } } ] }
    Pose { translation 0 -0.08 0.245 children [ Shape { appearance USE SLOTAPP geometry Box { size 0.26 0.014 0.05 } } ] }
    Pose { translation 0  0.08 0.245 children [ Shape { appearance USE SLOTAPP geometry Box { size 0.26 0.014 0.05 } } ] }
    # glowing colour pads (lifted above the platform top 0.22 → no z-fighting)
    Pose { translation 0 -0.16 0.226 children [ Shape { appearance PBRAppearance { baseColor 0.12 0.30 0.95 emissiveColor 0.12 0.30 0.95 emissiveIntensity 0.6 roughness 0.4 } geometry Box { size 0.20 0.15 0.012 } } ] }
    Pose { translation 0 0.00 0.226 children [ Shape { appearance PBRAppearance { baseColor 0.90 0.10 0.10 emissiveColor 0.90 0.10 0.10 emissiveIntensity 0.6 roughness 0.4 } geometry Box { size 0.20 0.15 0.012 } } ] }
    Pose { translation 0 0.16 0.226 children [ Shape { appearance PBRAppearance { baseColor 0.10 0.80 0.15 emissiveColor 0.10 0.80 0.15 emissiveIntensity 0.6 roughness 0.4 } geometry Box { size 0.20 0.15 0.012 } } ] }
  ]
  name "slot_stand"
  boundingObject Pose { translation 0 0 0.11 children [ Box { size 0.26 0.54 0.22 } ] }
}




# ── checkpoints ──
DEF CP1 Checkpoint { translation 2.6 0 0.03 name "cp1" radius 0.45 color 0.95 0.85 0.1 }
# 10 collectible checkpoints SCATTERED over the maze (same colour on purpose — their
# placement deliberately does NOT trace the route; collect in ANY order, each +10)
DEF CP2 Checkpoint { translation 5.2 0 0.03 name "cp2" radius 0.4 }
DEF CP3 Checkpoint { translation 7.8 0 0.03 name "cp3" radius 0.4 }
DEF CP4 Checkpoint { translation 10.4 1.3 0.03 name "cp4" radius 0.4 }
DEF CP5 Checkpoint { translation 13 1.3 0.03 name "cp5" radius 0.4 }
DEF CP6 Checkpoint { translation 15.5 1.3 0.03 name "cp6" radius 0.4 }
DEF CP7 Checkpoint { translation 18.1 1.3 0.03 name "cp7" radius 0.4 }
DEF CP8 Checkpoint { translation 20.7 0.6 0.03 name "cp8" radius 0.4 }
DEF CP9 Checkpoint { translation 23.3 1.3 0.03 name "cp9" radius 0.4 }
DEF CP10 Checkpoint { translation 25.8 -0.9 0.03 name "cp10" radius 0.4 }
DEF CP11 Checkpoint { translation 28.4 -1 0.03 name "cp11" radius 0.4 }
DEF FINISH Checkpoint { translation 31.0 -0.75 0.03 name "finish" radius 0.3 color 0.6 0.2 0.9 }

