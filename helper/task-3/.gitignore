# локальное окружение и сгенерированные на месте файлы — не коммитим
.venv/
__pycache__/
*.pyc

# runtime.ini генерируется скриптом запуска под конкретную машину (путь к .venv)
**/controllers/*/runtime.ini

# результаты локальных прогонов судьи
**/controllers/referee/result.json
result.json
*.mp4

# файлы проекта/кэш Webots
*.wbproj
.*.wbproj

# локальные отладочные логи (Webots/Docker-прогоны) и рантайм-логи Nav2/slam_toolbox
# (пишутся ros/process_manager.py при каждом запуске ROS2-стека — не результат, а мусор)
docker_run*.log
webots_native*.log
controllers/participant/logs/

# ОС
.DS_Store
Thumbs.db
