Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Help Height: 0
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Value: true
      Cell Size: 1
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Color: 160; 160; 164
      Alpha: 0.5
    - Class: rviz_default_plugins/RobotModel
      Name: Go2
      Enabled: true
      Value: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
    - Class: rviz_default_plugins/LaserScan
      Name: Scan
      Enabled: true
      Value: true
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Flat Squares
      Size (m): 0.05
      Color Transformer: FlatColor
      Color: 255; 40; 40
      Alpha: 1
      Decay Time: 0
    - Class: rviz_default_plugins/MarkerArray
      Name: Obstacles
      Enabled: true
      Value: true
      Topic:
        Value: /fake_go2/obstacles
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/MarkerArray
      Name: Mission
      Enabled: true
      Value: true
      Topic:
        Value: /go2_controller/markers
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/PointCloud2
      Name: Bridge cloud
      Enabled: true
      Value: true
      Topic:
        Value: /go2/lidar/points
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 3
      Color Transformer: AxisColor
      Axis: Z
      Use Fixed Frame: true
      Alpha: 0.8
      Decay Time: 0
    - Class: rviz_default_plugins/MarkerArray
      Name: Truth pose
      Enabled: true
      Value: true
      Topic:
        Value: /fake_go2/truth
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Path
      Name: Trajectory
      Enabled: true
      Value: true
      Topic:
        Value: /fake_go2/path
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color: 60; 160; 255
      Line Style: Billboards
      Line Width: 0.03
      Alpha: 1
  Global Options:
    Background Color: 40; 42; 48
    Fixed Frame: odom
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: <Fixed Frame>
      Distance: 6.5
      Focal Point:
        X: 2.2
        Y: 0
        Z: 0
      Pitch: 0.75
      Yaw: 3.5
      Near Clip Distance: 0.01
      Value: Orbit (rviz)
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1600
  Hide Left Dock: false
  Hide Right Dock: true
